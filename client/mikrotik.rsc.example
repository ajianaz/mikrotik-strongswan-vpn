# =============================================================================
# MikroTik RouterOS — IKEv2 VPN Client (TEMPLATE)
# =============================================================================
#
# DO NOT EDIT THIS FILE DIRECTLY.
# This is a template. Generated config: client/mikrotik.rsc
#
# Run: bash scripts/setup.sh  (reads .env, generates mikrotik.rsc)
#
# COMPATIBILITY: RouterOS 6.49.x AND 7.x
#
# PLACEHOLDERS (replaced by setup.sh):
#   {{SERVER_PUBLIC_IP}}    — VPS public IPv4
#   {{VPN_PSK}}             — Pre-shared key
#   {{CLIENT_LAN_SUBNET}}   — MikroTik LAN subnet
#   {{CLIENT_FQDN}}         — MikroTik identity FQDN
#   {{VPN_POOL_SUBNET}}     — VPN virtual IP pool
#
# =============================================================================


# ── STEP 1: IPsec Proposal (Child SA / data plane) ──
/ip ipsec proposal
add name=ike2-proposal \
    auth-algorithms=sha256 \
    enc-algorithms=aes-256-cbc \
    pfs-group=ecp384 \
    lifetime=1h


# ── STEP 2: IPsec Profile (IKE SA / control channel) ──
/ip ipsec profile
add name=ike2-profile \
    dh-group=ecp384 \
    enc-algorithm=aes-256 \
    hash-algorithm=sha256 \
    nat-traversal=yes \
    proposal-check=obey \
    exchange-mode=ike2


# ── STEP 3: IPsec Peer (remote server) ──
/ip ipsec peer
add address={{SERVER_PUBLIC_IP}}/32 \
    name=strongswan-server \
    profile=ike2-profile \
    auth-method=pre-shared-key \
    secret="{{VPN_PSK}}"


# ── STEP 4: IPsec Identity (auth credentials) ──
/ip ipsec identity
add peer=strongswan-server \
    my-id=fqdn:{{CLIENT_FQDN}} \
    peer-id=any \
    auth-method=pre-shared-key \
    secret="{{VPN_PSK}}"


# ── STEP 5: Mode Config (request virtual IP) ──
/ip ipsec mode-config
add name=ike2-mode-config \
    address={{VPN_POOL_SUBNET}} \
    connection-mark=default


# ── STEP 6: IPsec Policy (traffic selector) ──
/ip ipsec policy
add src-address={{VPN_POOL_SUBNET}} \
    dst-address={{CLIENT_LAN_SUBNET}} \
    proposal=ike2-proposal \
    sa-src-address=0.0.0.0 \
    sa-dst-address={{SERVER_PUBLIC_IP}} \
    tunnel=yes


# ── STEP 7: Bind mode-config + my-id to peer ──
/ip ipsec peer
set [find name=strongswan-server] \
    my-id=fqdn:{{CLIENT_FQDN}}


# =============================================================================
# VERIFICATION COMMANDS
# =============================================================================
# /ip ipsec proposal print where name=ike2-proposal
# /ip ipsec peer print
# /ip ipsec active-peers print
# /ip ipsec installed-sa print
# /ping 10.10.10.1
# /log print follow where topics=ipsec
# =============================================================================


