# ═══════════════════════════════════════════════════════════════
# VPN Configuration — MANDATORY: fill ALL fields
# ═══════════════════════════════════════════════════════════════
#
# Usage:
#   cp .env.example .env
#   nano .env
#   bash scripts/validate.sh
#   bash scripts/setup.sh
#   bash scripts/deploy.sh
#
# Generate PSK: bash scripts/generate-psk.sh
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
# Your VPS public IPv4 address (e.g. 152.70.xx.xx)
SERVER_PUBLIC_IP=

# Optional FQDN (e.g. vpn.example.com). Leave empty if unused.
SERVER_FQDN=

# ── Authentication ────────────────────────────────────────────
# Pre-Shared Key. Generate with: bash scripts/generate-psk.sh
# Minimum 24 characters. Validated automatically.
VPN_PSK=

# ── Authentication Type ──────────────────────────────────────
# "eap" = IKEv2 EAP-MSCHAPv2 (RouterOS 6.45+, recommended)
# "l2tp" = L2TP/IPsec (RouterOS < 6.45 fallback)
# "both" = enable both protocols
AUTH_TYPE=eap

# ── Rate Limiting (iptables) ─────────────────────────────────
EAP_MAX_LOGIN_ATTEMPTS=5
EAP_LOCKOUT_DURATION_MINUTES=15

# ── Client (MikroTik) ────────────────────────────────────────
# Your MikroTik LAN subnet (CIDR notation)
CLIENT_LAN_SUBNET=192.168.88.0/24

# MikroTik identity FQDN (used as IKE local ID)
CLIENT_FQDN=router-a.example.com

# ── VPN Pool ──────────────────────────────────────────────────
# Virtual IP pool for VPN clients
VPN_POOL_SUBNET=10.10.10.0/24

# L2TP IP pool (defaults to match VPN_POOL_SUBNET)
VPN_POOL_RANGE=10.10.10.2-10.10.10.254
VPN_POOL_LOCAL_IP=10.10.10.1

# ── Advanced (Optional) ──────────────────────────────────────
# charon log level: 0=none, 1=audit, 2=control, 3=more (default)
# Use 4 for raw debugging, 5 for private key material (DANGEROUS)
# STRONGSWAN_LOGLEVEL=4

# ── PostgreSQL ───────────────────────────────────────────────
# Used by vpn-manager API for tunnel management
POSTGRES_USER=vpnuser
POSTGRES_PASSWORD=
POSTGRES_DB=vpnmgr

# ── VPN Manager API ──────────────────────────────────────────
# API key for authenticating requests to vpn-manager
API_KEY=

# HTTP listen address (default: :8080)
# LISTEN=:8080
# Internal port for healthcheck + updown.sh (default: 8080)
# LISTEN_PORT=8080
