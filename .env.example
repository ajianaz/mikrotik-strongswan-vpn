# ═══════════════════════════════════════════════════════════════
# VPN Configuration — MANDATORY: fill ALL fields
# ═══════════════════════════════════════════════════════════════
#
# Usage:
#   cp .env.example .env
#   nano .env
#   bash scripts/validate.sh
#   bash scripts/setup.sh
#
# Generate PSK: bash scripts/generate-psk.sh
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
# Your VPS public IPv4 address (e.g. 152.70.xx.xx)
SERVER_PUBLIC_IP=

# Optional FQDN (e.g. vpn.example.com). Leave empty if unused.
SERVER_FQDN=

# ── Authentication ────────────────────────────────────────────
# Pre-Shared Key. Generate with: bash scripts/generate-psk.sh
# Minimum 24 characters. Validated automatically.
VPN_PSK=

# ── Client (MikroTik) ────────────────────────────────────────
# Your MikroTik LAN subnet (CIDR notation)
CLIENT_LAN_SUBNET=192.168.88.0/24

# MikroTik identity FQDN (used as IKE local ID)
CLIENT_FQDN=router-a.example.com

# ── VPN Pool ──────────────────────────────────────────────────
# Virtual IP pool for VPN clients
VPN_POOL_SUBNET=10.10.10.0/24

# ── Advanced (Optional) ──────────────────────────────────────
# charon log level: 0=none, 1=audit, 2=control, 3=more (default)
# Use 4 for raw debugging, 5 for private key material (DANGEROUS)
# STRONGSWAN_LOGLEVEL=3

# ── VPN Manager API ──────────────────────────────────────────
# PostgreSQL connection string (required for API service)
DB_URL=postgres://vpnuser:vpnpass@db:5432/vpnmgr?sslmode=disable

# API key for authenticating requests (required)
API_KEY=

# HTTP listen address (default: :8080)
# LISTEN=:8080

# Docker container name of the strongSwan VPN server (default: vpn-server)
# VPN_CONTAINER=vpn-server

# Path to swanctl conf.d inside the container (default: /etc/swanctl/conf.d)
# VPN_CONFIG_DIR=/etc/swanctl/conf.d

# Path to swanctl secret file inside the container (default: /etc/swanctl/secret)
# VPN_SECRET_FILE=/etc/swanctl/secret
