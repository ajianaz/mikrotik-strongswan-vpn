# PostgreSQL
POSTGRES_PASSWORD=change-me
POSTGRES_USER=vpnuser
POSTGRES_DB=vpnmgr

# VPN Manager
API_KEY=generate-random-key
ENCRYPTION_KEY=$(openssl rand -base64 32)
SERVER_PUBLIC_IP=your.server.ip

# Database connection (use container name, not service name)
DB_URL=postgres://vpnuser:change-me@vpn-db:5432/vpnmgr?sslmode=disable

# L2TP
L2TP_PSK=your-l2tp-psk

# Traefik
DOMAIN=vpn-dev.ajianaz.dev

# Optional
LISTEN_PORT=6060
STRONGSWAN_LOGLEVEL=3
VPN_POOL_RANGE=10.10.10.2-10.10.10.254
VPN_POOL_LOCAL_IP=10.10.10.1
VPN_LOCAL_IP=10.10.10.1
