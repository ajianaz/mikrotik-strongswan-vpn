# =============================================================================
# strongSwan swanctl — IKEv2 Roadwarrior (TEMPLATE)
# =============================================================================
#
# DO NOT EDIT THIS FILE DIRECTLY.
# This is a template. Generated config: config/conf.d/vpn.conf
#
# Run: bash scripts/setup.sh  (reads .env, generates vpn.conf)
#
# PLACEHOLDERS (replaced by setup.sh):
#   {{SERVER_PUBLIC_IP}}   — VPS public IPv4
#   {{VPN_POOL_SUBNET}}    — Client virtual IP pool
#
# NOTE: Secrets (PSK) are stored in a separate file: config/secret
#       This keeps connection config clean of sensitive data.
#
# =============================================================================

connections {

    roadwarrior {
        version = 2

        local {
            addrs = {{SERVER_PUBLIC_IP}}
            auth = psk
        }

        remote {
            addrs = %any
            auth = psk
        }

        children {
            net {
                local_ts = {{VPN_POOL_SUBNET}}
                remote_ts = dynamic
                esp_proposals = aes256-sha256-ecp384
                dpd_delay = 30s
                dpd_timeout = 120s
                rekey_time = 1h
                start_action = trap
            }
        }

        proposals = aes256-sha256-ecp384
        rekey_time = 4h
        keyingtries = 0
    }
}

pools {
    vpn-pool {
        addrs = {{VPN_POOL_SUBNET}}
    }
}
