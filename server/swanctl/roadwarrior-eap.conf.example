# strongSwan swanctl — IKEv2 Roadwarrior EAP-MSCHAPv2 (TEMPLATE)
#
# DO NOT EDIT — generated by setup.sh or placed by vpn-manager
#
# PLACEHOLDERS: {{SERVER_PUBLIC_IP}}, {{VPN_POOL_SUBNET}}

connections {
    roadwarrior-eap {
        version = 2

        local {
            addrs = {{SERVER_PUBLIC_IP}}
            auth = psk
            id = {{SERVER_PUBLIC_IP}}
        }

        remote {
            addrs = %any
            auth = eap-mschapv2
            eap_id = %any
        }

        children {
            net {
                local_ts = 0.0.0.0::0
                remote_ts = dynamic
                esp_proposals = aes256-sha256-ecp384
                dpd_delay = 30s
                dpd_timeout = 120s
                rekey_time = 1h
                start_action = trap
            }
        }

        proposals = aes256-sha256-ecp384
        rekey_time = 4h
        keyingtries = 0
    }
}

pools {
    vpn-pool {
        addrs = {{VPN_POOL_SUBNET}}
    }
}
