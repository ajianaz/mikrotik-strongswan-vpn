# L2TP/IPSec Tunnel: {{.TunnelID}}
# For RouterOS 6.x (all versions — IKEv1 + L2TP)
# Generated by vpn-manager

# L2TP Server Profile
/interface l2tp-client
add name=vpn-{{.TunnelID}} \
    connect-to={{.ServerIP}} \
    user="{{.Username}}" \
    password="{{.Password}}" \
    disabled=no

# IPSec Peer — IKEv1 Main Mode
/ip ipsec peer
add address={{.ServerIP}}/32 \
    name=vpn-{{.TunnelID}} \
    profile=vpn-l2tp-{{.TunnelID}} \
    exchange-mode=main \
    secret="{{.L2TPPSK}}"

# IPSec Profile — Legacy ciphers for RouterOS 6.x
/ip ipsec profile
add name=vpn-l2tp-{{.TunnelID}} \
    dh-group=modp1024,modp2048 \
    enc-algorithm=aes-128-cbc,aes-256-cbc \
    hash-algorithm=sha1 \
    lifetime=1h \
    proposal-check=obey

# IPSec Proposal
/ip ipsec proposal
add name=vpn-l2tp-{{.TunnelID}} \
    auth-algorithms=sha1 \
    enc-algorithms=aes-128-cbc,aes-256-cbc \
    pfs-group=modp1024,modp2048 \
    lifetime=1h
