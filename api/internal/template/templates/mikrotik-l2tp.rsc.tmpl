# VPN Tunnel: {{.TunnelID}}
# Auth: L2TP/IPsec MS-CHAPv2 (IKEv1 — compatible with all RouterOS versions)
# Generated by vpn-manager
#
# IMPORTANT: Replace SERVER_PUBLIC_IP with your VPN server's public IP address
# before importing this script on RouterOS.

# ── IPsec Proposal (IKEv1 compatible ciphers) ──
/ip ipsec proposal
add name=vpn-{{.TunnelID}} \
    auth-algorithms=sha1 \
    enc-algorithms=aes-256-cbc,aes-128-cbc,3des \
    pfs-group=modp1024 \
    lifetime=1h

# ── IPsec Peer (IKEv1 Main Mode) ──
/ip ipsec peer
add address=0.0.0.0/0 \
    name=vpn-{{.TunnelID}} \
    profile=vpn-{{.TunnelID}} \
    exchange-mode=main \
    secret="{{.L2TPPSK}}"

# ── IPsec Policy ──
/ip ipsec policy
add dst-address=0.0.0.0/0 \
    proposal=vpn-{{.TunnelID}} \
    sa-dst-address=0.0.0.0 \
    sa-src-address=0.0.0.0 \
    src-address=0.0.0.0/0 \
    template=yes

# ── L2TP Client ──
/interface l2tp-client
add connect-to={{.ServerPublicIP}} \
    name=vpn-{{.TunnelID}} \
    user="{{.Username}}" \
    password="{{.Password}}" \
    disabled=no \
    ipsec-secret="{{.L2TPPSK}}" \
    keepalive-timeout=60 \
    max-mtu=1400 \
    mru=1400

# ── Verification ──
# /interface l2tp-client monitor vpn-{{.TunnelID}}
# /ip ipsec active-peers print
