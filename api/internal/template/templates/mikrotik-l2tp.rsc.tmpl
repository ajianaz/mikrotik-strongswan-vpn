# VPN Tunnel: {{.TunnelID}}
# Auth: L2TP/IPsec MS-CHAPv2 (RouterOS < 6.45 fallback)
# Generated by vpn-manager

# ── IPsec Transport (wraps L2TP in IPsec) ──
/ip ipsec proposal
add name=vpn-{{.TunnelID}} \
    auth-algorithms=sha256 \
    enc-algorithms=aes-256-cbc \
    pfs-group=ecp384 \
    lifetime=1h

/ip ipsec peer
add address={{.PeerIP}}/32 \
    name=vpn-{{.TunnelID}} \
    profile=vpn-{{.TunnelID}} \
    exchange-mode=ike2

/ip ipsec policy
add dst-address={{.PeerIP}}/32 \
    proposal=vpn-{{.TunnelID}} \
    sa-dst-address={{.PeerIP}} \
    sa-src-address=0.0.0.0 \
    src-address=0.0.0.0/0 \
    template=yes

# ── L2TP Client ──
/interface l2tp-client
add connect-to={{.PeerIP}} \
    name=vpn-{{.TunnelID}} \
    user="{{.Username}}" \
    password="{{.Password}}" \
    disabled=no \
    ipsec-secret="" \
    keepalive-timeout=60 \
    max-mtu=1400 \
    mru=1400

# ── Verification ──
# /interface l2tp-client monitor vpn-{{.TunnelID}}
# /ip ipsec active-peers print
