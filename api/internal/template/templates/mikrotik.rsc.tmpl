# VPN Tunnel: {{.TunnelID}}
# Generated by vpn-manager

/ip ipsec profile
add name=vpn-{{.TunnelID}} dh-group=ecp384 enc-algorithm=aes-256 hash-algorithm=sha256 lifetime=1h

/ip ipsec peer
add address={{.PeerIP}}/{{.LocalSubnet}} name=vpn-{{.TunnelID}} profile=vpn-{{.TunnelID}} \
    exchange-mode=ike2 secret="{{.PSK}}"

/ip ipsec proposal
add name=vpn-{{.TunnelID}} auth-algorithms=sha256 enc-algorithms=aes-256-cbc lifetime=1h pfs-group=ecp384

/ip ipsec policy
add dst-address={{.LocalSubnet}} ipsec-proposals=vpn-{{.TunnelID}} \
    peer=vpn-{{.TunnelID}} src-address=0.0.0.0/0 template=yes
