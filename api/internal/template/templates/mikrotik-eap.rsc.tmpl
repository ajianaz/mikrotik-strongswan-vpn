# VPN Tunnel: {{.TunnelID}}
# Auth: IKEv2 EAP-MSCHAPv2 (RouterOS 6.45+ / 7.x)
# Generated by vpn-manager

# ── IPsec Proposal ──
/ip ipsec proposal
add name=vpn-{{.TunnelID}} \
    auth-algorithms=sha256 \
    enc-algorithms=aes-256-cbc \
    pfs-group=ecp384 \
    lifetime=1h

# ── IPsec Profile ──
/ip ipsec profile
add name=vpn-{{.TunnelID}} \
    dh-group=ecp384 \
    enc-algorithm=aes-256 \
    hash-algorithm=sha256 \
    nat-traversal=yes \
    proposal-check=obey \
    exchange-mode=ike2

# ── IPsec Peer ──
/ip ipsec peer
add address={{.PeerIP}}/32 \
    name=vpn-{{.TunnelID}} \
    profile=vpn-{{.TunnelID}} \
    passive=no

# ── IPsec Identity (EAP auth) ──
/ip ipsec identity
add peer=vpn-{{.TunnelID}} \
    auth-method=eap \
    eap-methods=eap-mschapv2 \
    username="{{.Username}}" \
    password="{{.Password}}" \
    generate-policy=port-strict

# ── Mode Config ──
/ip ipsec mode-config
add name=vpn-{{.TunnelID}}-mode-config \
    connection-mark=default

# ── Verification ──
# /ip ipsec active-peers print
# /ip ipsec installed-sa print
